---
artifact:
  spec:           { label: "SPEC.md (言語仕様)",               status: done }
  samples:        { label: "example-*.shitae (検証済みサンプル)", status: done }
  ast_pkg:        { label: "@shitae/ast",                      status: done }
  parser_pkg:     { label: "@shitae/parser",                   status: done }
  resolver_pkg:   { label: "@shitae/resolver",                 status: done }
  mermaid_pkg:    { label: "@shitae/transpiler-mermaid",       status: done }
  checker_pkg:    { label: "@shitae/checker",                  status: done }
  cli_pkg:        { label: "@shitae/cli",                      status: done }
  mmd_files:      { label: "*.mmd (Mermaid フローチャート)",     status: done }
  cross_resolver: { label: "@shitae/resolver (cross-file対応)", status: done }
  cli_crossfile:  { label: "cli import 自動ロード/project対応", status: done,
                    description: "単一ファイル入口から import を辿り同ディレクトリ .shitae を自動ロードして resolveProject を呼ぶ。" }
  runtime_pkg:    { label: "@shitae/runtime",                  status: done,
                    description: "push/back/goto/exit/dismiss のスタック意味論を実装する共通実行モデル。xstate transpiler と simulator の両方が依存する。" }
  xstate_pkg:     { label: "@shitae/transpiler-xstate",        status: done,
                    description: "XState v5 state machine を生成。push=context stack, back()=predecessor guards, goto=simple transition。1 Document = 1 Machine。" }
  xstate_files:   { label: "*.ts (XState 状態機械)",            status: todo }
  simulator:      { label: "@shitae/simulator",                 status: done,
                    description: "shitae simulate <file> で単一 HTML 生成。現在地(component/variation)の要素とアクション一覧を表示し、クリックで状態遷移。複数 result はラベル付きボタンで選択。effect は画面留まりトースト表示。push/back でスタック管理。依存ゼロのブラウザ完結。" }
  span_fix:       { label: "Span 精度 (offset/col)",            status: done }
  sim_shitae:     { label: "simulator.shitae (ドッグフード設計図)", status: todo,
                    description: "simulator 自体の画面フローを .shitae で書く。設計者が shitae を使って揉み、言語の不足・不満をフィードバックして仕様に反映する。" }
  sim_polished:   { label: "@shitae/simulator (polish済み)",    status: todo,
                    description: "sim_shitae のドッグフードで発見したバグ・UX 問題を修正。セッション/back の壁の視覚化、variation 初期表示、エラー表示等。" }

process:
  design:  { label: "言語設計" }
  phase1:  { label: "Phase 1: AST + Parser" }
  phase2:  { label: "Phase 2: resolver / mermaid / checker / cli" }
  phase3:  { label: "Phase 3: runtime" }
  phase4:  { label: "Phase 4: cross-file resolver + cli" }
  phase5:  { label: "Phase 5: XState transpiler" }
  phase6:  { label: "Phase 6: simulator" }
  phase7:  { label: "Phase 7: span精度" }
  phase8:  { label: "Phase 8: dogfood" }
  phase9:  { label: "Phase 9: simulator polish" }

statusStyles:
  done: { fillcolor: "#d4edda", style: filled }
  wip:  { fillcolor: "#fff3cd", style: filled }
  todo: { fillcolor: "#f8f9fa", style: filled }
layout:
  direction: td
  maxWidth: 200
---
spec >> design -> samples
[spec, samples] >> phase1 -> [ast_pkg, parser_pkg]
[ast_pkg, parser_pkg] >> phase2 -> [resolver_pkg, mermaid_pkg, checker_pkg, cli_pkg]
[resolver_pkg, mermaid_pkg] >> phase2 -> mmd_files
[ast_pkg, parser_pkg] >> phase3 -> runtime_pkg
[resolver_pkg, parser_pkg] >> phase4 -> [cross_resolver, cli_crossfile]
[ast_pkg, parser_pkg, cross_resolver, runtime_pkg] >> phase5 -> [xstate_pkg, xstate_files]
[parser_pkg, cross_resolver, runtime_pkg] >> phase6 -> simulator
parser_pkg >> phase7 -> span_fix
simulator >> phase8 -> sim_shitae
sim_shitae >> phase9 -> sim_polished
