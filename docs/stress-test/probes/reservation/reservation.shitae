# 店舗一覧
検索バー: {
  検索フィールド
}
*店舗: {
  写真
  店名
  評価
}
> タップ(検索フィールド) -> 検索入力可能
> タップ(店舗) -> push(店舗詳細)
> タップ(マイ予約) -> push(マイ予約一覧)

# 店舗詳細
写真
メニュー
予約するボタン
> タップ(予約するボタン) -> present(予約フロー, @reservation)
> タップ(戻る) -> back()

# 予約フロー
## 日付選択
日付カレンダー: {
  *日付
}
> タップ(日付.選択可能?) -> goto(##人数選択)
> タップ(日付.キャンセル待ち登録?) -> キャンセル待ちに登録

## 人数選択
人数セレクタ: {
  *人数オプション
}
> タップ(人数オプション) -> goto(##予約確認)
> タップ(戻る) -> goto(##日付選択)

## 予約確認
選択日付
選択人数
予約内容確認
確定ボタン
> タップ(確定ボタン) -> 予約を確定する ; goto(##予約完了)
> タップ(戻る) -> goto(##人数選択)

## 予約完了
完了メッセージ
> タップ(閉じる) -> dismiss(@reservation)

# 日付
## 空きあり
選択対象: 日付テキスト

## 満席
日付テキスト
キャンセル待ち登録: キャンセル待ちボタン

# マイ予約一覧
> タップ(戻る) -> back()
*予約: {
  予約情報要約
}
> タップ(予約) -> push(予約詳細)

# 予約詳細
予約情報詳細
キャンセルボタン
> タップ(キャンセルボタン) -> present(予約キャンセル確認)
> タップ(戻る) -> back()

# 予約キャンセル確認
確認メッセージ
はいボタン
いいえボタン
> タップ(はいボタン) -> 予約をキャンセルする ; dismiss() ; back()
> タップ(いいえボタン) -> dismiss()
